---
import '../styles/global.css';
import { buildSite as site } from '../config/build-site';
interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
const canonical = site.origin && !noindex ? new URL(Astro.url.pathname, site.origin).href : undefined;
const socialImage = canonical ? new URL('/guide/conversion.png', site.origin).href : undefined;
const imageAlt = 'WebP to PNG converter showing completed images, output sizes, and PNG downloads.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={site.indexable && !noindex ? 'index, follow' : 'noindex, follow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    {site.analytics && canonical && <meta name="analytics-domain" content={new URL(canonical).hostname} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <>
      <meta property="og:image" content={socialImage} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1440" />
      <meta property="og:image:height" content="900" />
      <meta property="og:image:alt" content={imageAlt} />
    </>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <><meta name="twitter:image" content={socialImage} /><meta name="twitter:image:alt" content={imageAlt} /></>}
    <slot name="head" />
    <meta name="theme-color" content="#244c38" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script>
      import { track } from '../lib/analytics';
      track('pageview');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header"><nav class="shell nav-inner" aria-label="Main navigation">
      <a class="wordmark" href="/" aria-label={`${site.name} home`}><span class="brand-symbol" aria-hidden="true">↳</span>{site.name}</a>
      <div class="nav-links"><a href="/guides/convert-webp-to-png/" aria-current={Astro.url.pathname.startsWith('/guides/') ? 'page' : undefined}>Guide</a><a href="/about/" aria-current={Astro.url.pathname === '/about/' ? 'page' : undefined}>About</a></div>
    </nav></header>
    <main class="shell" id="main"><slot /></main>
    <footer class="site-footer"><div class="shell footer-inner"><p>{site.name} <span aria-hidden="true">·</span> A little less format friction.</p><nav class="footer-links" aria-label="Footer navigation"><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></nav></div></footer>
  </body>
</html>
