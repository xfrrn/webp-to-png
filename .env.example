# Explicitly local | preview | production. NODE_ENV does not control indexing.
DEPLOY_ENV=local
# Required for production; use your verified HTTPS origin, with no path.
SITE_URL=
PUBLIC_SITE_NAME=WebP to PNG Converter
MAINTAINER_NAME=
CONTACT_EMAIL=
# Optional: add your SITE_URL hostname in Plausible before enabling. No API key needed.
# Only sends events in DEPLOY_ENV=production. Leave false to make no analytics requests.
PLAUSIBLE_ENABLED=false
