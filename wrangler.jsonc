{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webp-to-png-converter",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "webp-to-png.actify.icu",
      "custom_domain": true,
    },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
}
